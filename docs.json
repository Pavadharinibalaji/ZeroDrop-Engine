
{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ZeroDrop Engine",
  "description": "Engineering documentation for ZeroDrop Engine, a high-concurrency flash sale inventory reservation and order management system.",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",

  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub Repository",
          "href": "https://github.com/Pavadharinibalaji/ZeroDrop-Engine"
        },
        {
          "anchor": "Report an Issue",
          "href": "https://github.com/Pavadharinibalaji/ZeroDrop-Engine/issues"
        }
      ]
    }
  },

  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },

  "navbar": {
    "links": [
      {
        "label": "GitHub Issues",
        "href": "https://github.com/Pavadharinibalaji/ZeroDrop-Engine/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "View Source",
      "href": "https://github.com/Pavadharinibalaji/ZeroDrop-Engine"
    }
  },

  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },

  "footer": {
